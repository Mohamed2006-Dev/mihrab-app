{
  "name": "mihrab-desktop",
  "version": "1.0.3",
  "description": "محراب لتنظيم الصلاة وقراءة أوراد القرآن بحفص وورش ومتابعة الأذكار والأحاديث والدروس، مع شاشة التهيئة للصلاة وقوالب عصرية وتقليدية.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "locales:check": "python scripts/sync-locales.py check",
    "locales:draft": "python scripts/sync-locales.py draft",
    "locales:apply": "python scripts/sync-locales.py apply"
  },
  "keywords": [
    "prayer-times",
    "islamic",
    "electron",
    "quran",
    "hadith",
    "themes"
  ],
  "author": "Mihrab Desktop",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "adhan": "^4.4.3",
    "electron-updater": "^6.8.11",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.18.0",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "com.mihrab.desktop",
    "productName": "Mihrab",
    "copyright": "Copyright © 2026 Mihrab Desktop",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "themes/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powertests,example,examples}",
      "!**/*.map",
      "!build_app.py",
      "!test-engines.js",
      "!test-youtube-rss.js",
      "!Project_Assets/**/*",
      "LICENSE",
      "!themes/active-theme.json",
      "data/geography/**/*",
      "data/cities.json",
      "data/local-hadith-sharh.json",
      "data/quran-meta-hafs.json",
      "data/quran-meta-warsh.json",
      "data/quran-metadata.json",
      "data/quran-partitions-LICENSE.txt",
      "data/quran-sources.md",
      "data/seed-hadiths.json",
      "data/youtube-contexts.json"
    ],
    "extraResources": [
      {
        "from": "themes",
        "to": "themes",
        "filter": [
          "**/*",
          "!active-theme.json"
        ]
      },
      {
        "from": "data",
        "to": "data",
        "filter": [
          "geography/**/*",
          "cities.json",
          "local-hadith-sharh.json",
          "quran-meta-hafs.json",
          "quran-meta-warsh.json",
          "quran-metadata.json",
          "quran-partitions-LICENSE.txt",
          "quran-sources.md",
          "seed-hadiths.json",
          "youtube-contexts.json"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "src/ui/assets/app-icon.ico"
    },
    "nsis": {
      "include": "scripts/local-sync-firewall.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mihrab",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mohamed2006-Dev",
        "repo": "mihrab-app"
      }
    ],
    "beforePack": "scripts/check-build-locales.cjs",
    "afterPack": "scripts/prepare-project-public-info.cjs"
  }
}
